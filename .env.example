# Copy to .env and fill in. Every VITE_* value is compiled into the client
# bundle by `pnpm build`, so changing one needs a rebuild, not just a restart.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Port to listen on; defaults to 3000 when unset. Managed hosts set this
# themselves — in production the server binds to exactly this port and exits if
# it is unavailable.
PORT=5000

# "development" runs Vite in middleware mode; "production" serves dist/public.
NODE_ENV=development

# MySQL connection string. Required for server-side note persistence, sharing,
# and collaboration. Without it the server still boots and the app runs
# local-only — DB-backed routes log a warning and no-op.
DATABASE_URL=mysql://user:password@host:3306/notepad_ai

# Signs session cookies, and derives the key that encrypts two-step
# verification secrets at rest. Use a long random value and keep it stable —
# rotating it signs every existing session out *and* invalidates every
# authenticator enrolment, which means every affected person has to set theirs
# up again.
JWT_SECRET=

# ---------------------------------------------------------------------------
# OAuth
# ---------------------------------------------------------------------------
# Sign-in is unavailable unless both VITE_ values are set at build time; the
# client logs a warning and the Sign In button goes nowhere.

# Token exchange + user info, called server-side.
OAUTH_SERVER_URL=

# Portal the browser is sent to, and the app's ID. Both are build-time.
VITE_OAUTH_PORTAL_URL=
VITE_APP_ID=

# openId granted owner privileges. Optional.
OWNER_OPEN_ID=

# ---------------------------------------------------------------------------
# AI provider
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Sign-in methods (all optional; each is offered only when configured)
# ---------------------------------------------------------------------------

# The absolute origin this app is served from, e.g. https://notes.example.com.
# Required for Google sign-in and for links in email. Never derived from a
# request header: a reset link built from an attacker-supplied Host is a working
# reset token delivered to their server.
PUBLIC_ORIGIN=

# Google sign-in. Create an OAuth client (type "Web application") in the Google
# Cloud console and register this exact redirect URI:
#   <PUBLIC_ORIGIN>/api/auth/google/callback
# The secret is server-side only. There is deliberately no VITE_ equivalent.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# reCAPTCHA on sign-in, registration and password reset. Create a v2 "I'm not
# a robot" checkbox site at https://www.google.com/recaptcha/admin and register
# this app's domain. A v3 key also works — the server checks the score when one
# is present.
#
# The site key is public by design and is served to the browser at runtime, so
# rotating it needs no rebuild. Neither key gets a VITE_ prefix. Leave both
# unset and the check is simply not offered.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Transactional email, for address confirmation and password reset. Any JSON
# email API with a {from,to,subject,text} body works — Resend, Postmark,
# SendGrid. Without all three, email sign-up reports itself unavailable rather
# than accepting registrations whose confirmation link never arrives.
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=

# ---------------------------------------------------------------------------
# AI provider
# ---------------------------------------------------------------------------

# Used by the writing assistant, voice transcription and template drafting.
# All three call the provider from the server, so this key stays out of the
# browser bundle. There is deliberately no VITE_-prefixed equivalent: those are
# substituted into the client at build time and would be public.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# ---------------------------------------------------------------------------
# Demo session limit (optional)
# ---------------------------------------------------------------------------
# Signed-out visitors get 30 minutes in the workspace. That limit is enforced in
# the browser, so clearing site data or opening a private window resets it.
#
# Setting a salt here also records the deadline server-side, keyed to an HMAC of
# the visitor's IP address and coarse browser family. The address itself is
# never stored — only the hash — and records are deleted 24 hours after the demo
# ends. Without the salt, nothing is recorded and the limit stays browser-only.
#
# Note that this is a deterrent, not enforcement: people behind one office or
# mobile NAT share an address, so one visitor's demo can use up another's.
# Use a long random value; changing it invalidates every existing record.
DEMO_LIMIT_SALT=

# ---------------------------------------------------------------------------
# Encrypted cloud backup (optional)
# ---------------------------------------------------------------------------
# Leave S3_BUCKET unset and the feature reports itself unavailable — the app
# hides the Cloud button rather than offering one that errors.
#
# Archives are encrypted in the browser before upload, so the bucket only ever
# holds ciphertext. Credentials come from the standard AWS environment
# variables or an instance role.

S3_BUCKET=
S3_REGION=
# Optional: MinIO, Cloudflare R2, or another S3-compatible endpoint.
S3_ENDPOINT=

# ---------------------------------------------------------------------------
# Analytics (optional)
# ---------------------------------------------------------------------------
# Substituted into client/index.html at build time.

VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
