# Copy to .env and fill in. Every VITE_* value is compiled into the client
# bundle by `pnpm build`, so changing one needs a rebuild, not just a restart.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Port to listen on; defaults to 3000 when unset. Managed hosts set this
# themselves — in production the server binds to exactly this port and exits if
# it is unavailable.
PORT=5000

# "development" runs Vite in middleware mode; "production" serves dist/public.
NODE_ENV=development

# MySQL connection string. Required for server-side note persistence, sharing,
# and collaboration. Without it the server still boots and the app runs
# local-only — DB-backed routes log a warning and no-op.
DATABASE_URL=mysql://user:password@host:3306/notepad_ai

# Signs session cookies. Use a long random value and keep it stable — rotating
# it signs every existing session out.
JWT_SECRET=

# ---------------------------------------------------------------------------
# OAuth
# ---------------------------------------------------------------------------
# Sign-in is unavailable unless both VITE_ values are set at build time; the
# client logs a warning and the Sign In button goes nowhere.

# Token exchange + user info, called server-side.
OAUTH_SERVER_URL=

# Portal the browser is sent to, and the app's ID. Both are build-time.
VITE_OAUTH_PORTAL_URL=
VITE_APP_ID=

# openId granted owner privileges. Optional.
OWNER_OPEN_ID=

# ---------------------------------------------------------------------------
# AI provider
# ---------------------------------------------------------------------------

BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Client-side AI calls. Anything here ships to the browser — do not put a
# secret key in these.
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

# ---------------------------------------------------------------------------
# Analytics (optional)
# ---------------------------------------------------------------------------
# Substituted into client/index.html at build time.

VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
